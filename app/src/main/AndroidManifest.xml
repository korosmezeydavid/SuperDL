            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="gps_route_recording" />
        </service>

        <!-- GPS Útvonal – mentett útvonal hangos követése -->
