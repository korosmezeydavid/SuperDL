        <receiver
            android:name=".sms.SmsSendReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.superdl.launcher.SMS_SENT" />
                <action android:name="com.superdl.launcher.SMS_DELIVERED" />
            </intent-filter>
